{
  "name": "my-city",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:svg": "pnpm --filter @my-city/svg dev",
    "build:svg": "pnpm --filter @my-city/svg build",
    "build:iso-glow": "pnpm --filter @my-city/svg build:iso-glow",
    "preview:svg": "pnpm --filter @my-city/svg preview",
    "test:svg": "pnpm --filter @my-city/svg test",
    "lint:svg": "pnpm --filter @my-city/svg lint",
    "typecheck:svg": "pnpm --filter @my-city/svg typecheck",
    "dev:3d": "pnpm --filter @my-city/city3d dev",
    "build:3d": "pnpm --filter @my-city/city3d build",
    "preview:3d": "pnpm --filter @my-city/city3d preview",
    "test:3d": "pnpm --filter @my-city/city3d test",
    "lint:3d": "pnpm --filter @my-city/city3d lint",
    "typecheck:3d": "pnpm --filter @my-city/city3d typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "fetch:osm": "pnpm --filter @my-city/osm-data fetch"
  },
  "packageManager": "pnpm@10.21.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
